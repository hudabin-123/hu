#include <stdio.h>
 int main() {
     int arr[5];
     int count = 0; // 记录已输入的偶数个数
     
     printf("请输入数字（奇数需重新输入，回车分隔）：\n");
     // 循环输入，直到获取5个偶数
     while (count < 5) {
         int num;
         scanf("%d", &num);
         if (num % 2 == 0) { // 仅保留偶数
             arr[count] = num;
             count++;
         }
     }
     
     // 输出数组（最后一位后无空格）
     for (int i = 0; i < 5; i++) {
         if (i > 0) {
             printf(" ");
         }
         printf("%d", arr[i]);
     }
     printf("\n");
     return 0;
 }
