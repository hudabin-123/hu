#include <stdio.h>
 int main() {
     int arr[5]; // 长度为5的作业提交记录数组
     
     // 输入当前前4位学号
     printf("请输入前4位学生学号（空格分隔）：");
     for (int i = 0; i < 4; i++) {
         scanf("%d", &arr[i]);
     }
     // 数组整体后移一位（原第4位移到第5位）
     arr[4] = arr[3];
     arr[3] = arr[2];
     arr[2] = arr[1];
     arr[1] = arr[0];
     arr[0] = 0; // 首位补0
     
     // 输出更新后的数组
     for (int i = 0; i < 5; i++) {
         if (i > 0) {
             printf(" ");
         }
         printf("%d", arr[i]);
     }
     printf("\n");
     return 0;
 }
